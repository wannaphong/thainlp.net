<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>ThaiNLP.NET</PackageId>
    <Version>0.1.0</Version>
    <Authors>Wannaphong Phatthiyaphaibun</Authors>
    <Company>ThaiNLP</Company>
    <Product>ThaiNLP.NET</Product>
    <Description>Thai Natural Language Processing library for .NET - Word tokenization, TCC segmentation, and more</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wannaphong/thainlp.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wannaphong/thainlp.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>thai;nlp;natural-language-processing;tokenization;word-segmentation;tcc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Update="words_th.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any;content</PackagePath>
    </None>
  </ItemGroup>

</Project>
